rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBracUser() {
      return isSignedIn()
        && request.auth.token.email.matches('.*@brac\\.net$');
    }

    function currentUserDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentChampionDoc() {
      // Requires the backend's create-account endpoint to call
      // admin.auth().createUser({ uid: championId, email }) so the Firestore
      // doc ID and the champion's Firebase Auth UID are the same value.
      return /databases/$(database)/documents/champions_pool/$(request.auth.uid);
    }

    function isActiveUser() {
      return isBracUser()
        && exists(currentUserDoc())
        && get(currentUserDoc()).data.status == "active";
    }

    function isAdmin() {
      return isActiveUser()
        && get(currentUserDoc()).data.role in ["super_admin", "admin"];
    }

    function isSuperAdmin() {
      return isActiveUser()
        && get(currentUserDoc()).data.role == "super_admin";
    }

    function isActiveChampion() {
      return isSignedIn()
        && exists(currentChampionDoc())
        && get(currentChampionDoc()).data.member_status == "Active"
        && get(currentChampionDoc()).data.account_status == "Active";
    }

    function isSelectionUser() {
      return isActiveUser() || isActiveChampion();
    }

    match /users/{userId} {
      allow read: if isBracUser()
        && (request.auth.uid == userId || isActiveUser());

      allow create: if isBracUser()
        && request.auth.uid == userId
        && request.resource.data.role == "pending"
        && request.resource.data.status == "pending";

      allow update, delete: if isSuperAdmin();
    }

    match /cohorts/{cohortId} {
      allow read: if isSelectionUser();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "total_registrations",
            "current_participant_sequence",
            "total_fgds",
            "updated_at"
          ]);
    }

    match /forms/{formId} {
      allow read: if true;

      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "total_responses",
            "updated_at"
          ]);

      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /form_fields/{fieldId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /form_responses/{responseId} {
      allow create: if true;
      // isSelectionUser() (not isActiveUser()) — an active champion needs
      // this to read a participant's application answers on the new
      // Selection Committee participant profile page, same as they can
      // already read the participants/fgds docs those answers belong to.
      allow read: if isSelectionUser();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /participants/{participantId} {
      allow create: if true;
      allow read: if isSelectionUser()
        || (isSignedIn() && request.auth.uid == participantId);
      // Any status field on a participant (selection/attendance/enrollment/
      // graduation/etc.) is super-admin-only, not just isAdmin().
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /fgds/{fgdId} {
      allow read: if isSelectionUser();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /champions_pool/{championId} {
      allow create: if request.resource.data.registration_status == "Pending"
        && request.resource.data.account_status == "Not Created"
        && request.resource.data.member_status == "Inactive";

      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == championId);

      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /participant_evaluations/{evaluationId} {
      allow read: if isAdmin() || isActiveChampion();
      allow delete: if isSuperAdmin();
      // Create/update only happen via the backend's Admin SDK
      // (requireActiveChampion verifies the evaluator is actually assigned
      // to the participant's FGD). Delete is super-admin-only so a regular
      // admin can't bulk-purge a cohort's data from the client.
    }

    match /fgd_change_requests/{requestId} {
      allow read: if isAdmin() || isActiveChampion();
      // Writes only happen via the backend's Admin SDK, same reasoning.
    }
  }
}
